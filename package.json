{
  "name": "dsh-skill-recursive",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: discover SKILL.md files in nested subfolders of .dsh/skills, .agents/skills, and the user skill roots, not just the first directory level.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "skills",
    "skill-discovery",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "DanielEstrada971102",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielEstrada971102/dsh-skill-recursive.git"
  },
  "bugs": {
    "url": "https://github.com/DanielEstrada971102/dsh-skill-recursive/issues"
  },
  "homepage": "https://github.com/DanielEstrada971102/dsh-skill-recursive#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --check index.js && node --check client.js && node --test tests/discovery.test.mjs tests/watcher.test.mjs tests/settings.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "node": ">=20",
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
